# ---------------------------------------------------------------- backend
DATABASE_URL=sqlite:///./tessera.db
# 32+ random characters in production
JWT_SECRET=tessera-dev-secret-please-change-in-production-32b
JWT_TTL_HOURS=12
TEAM_NAME=Voltryx
DATASET_PATH=./vendor/cit_public.json
DATA_DIR=./data                 # uploaded datasets (gitignored)
EXPORTS_DIR=./exports
LOAD_COMMITTED_EXPORTS=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------- demo accounts
# Safe to keep in the repo: these are demo logins, not real secrets.
# The competition demo uses one-click identities; disable in non-demo deployments.
DEMO_LOGIN_ENABLED=true
DEMO_PASSWORD=Tessera@2027
ADMIN_EMAIL=admin@cit.edu
DEAN_EMAIL=dean@cit.edu
DEPT_EMAIL=dept.cse@cit.edu
FACULTY_EMAIL=faculty@cit.edu
CLUB_EMAIL=club@cit.edu

# ---------------------------------------------------------------- solver
SOLVER_TIME_LIMIT=90
SOLVER_WORKERS=2
SOLVER_SEED=20270131
REPAIR_TIME_LIMIT=60

# ---------------------------------------------------------------- LLM (optional)
# none | groq.  The product is fully usable with none - the deterministic parser runs either way.
LLM_PROVIDER=none
# Free tier: ~1,000 requests/day and 100K tokens/day on the 70B model, 14,400/day on the 8B.
# NEVER put a real key in this file - it is committed. Copy it to .env instead:
#   sh tools/setup_env.sh        (creates .env, which is gitignored)
#   python3 tools/set_groq_key.py  (asks for the key with hidden input, writes .env)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=12
# Metering: calls/day on the primary and fallback model, and calls/minute. The budget is
# enforced in SQLite (reserved before the call, released on failure) so a demo cannot drain it.
LLM_RPD=1000
LLM_RPD_FALLBACK=14400
LLM_RPM=30

# ---------------------------------------------------------------- links
# Absolute origin of the deployed frontend; used in exports and in share/copy links. Empty = same origin.
WEB_APP_URL=
