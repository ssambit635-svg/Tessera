# Keep editors consistent with the conventions already used in this repo.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Markdown uses trailing spaces for hard line breaks.
trim_trailing_whitespace = false

[*.{json,csv}]
# Generated exports are rewritten by the API; leave their bytes alone.
insert_final_newline = false
trim_trailing_whitespace = false
